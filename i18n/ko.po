msgstr "지금 모든 세이브 백업"

msgid "Restore a backup…"
msgstr "백업 복원…"

msgid "Import a save file…"
msgstr "세이브 파일 가져오기…"

msgid "Enter: save actions   saves in {dir}"
msgstr "Enter: 세이브 작업   세이브 위치 {dir}"

