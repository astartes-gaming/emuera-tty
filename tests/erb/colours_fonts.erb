;=== colours, fonts, alignment, console state ===
@TEST_MAIN
SETCOLOR 0x112233
CALL CHECK, "setcolor getcolor", GETCOLOR() == 0x112233
SETCOLOR 255, 0, 0
CALL CHECK, "setcolor rgb", GETCOLOR() == 0xFF0000
RESETCOLOR
CALL CHECK, "resetcolor", GETCOLOR() == GETDEFCOLOR()
SETBGCOLOR 0x000080
CALL CHECK, "setbgcolor", GETBGCOLOR() == 0x000080
RESETBGCOLOR
CALL CHECK, "resetbgcolor", GETBGCOLOR() == GETDEFBGCOLOR()
SETCOLORBYNAME Red
CALL CHECK, "setcolorbyname", GETCOLOR() == 0xFF0000
RESETCOLOR
CALL CHECK, "color_fromname", COLOR_FROMNAME("Blue") == 0x0000FF && COLOR_FROMRGB(1, 2, 3) == 0x010203
FONTBOLD
CALL CHECK, "fontbold", GETSTYLE() & 1
FONTITALIC
CALL CHECK, "fontitalic", GETSTYLE() & 2
FONTREGULAR
CALL CHECK, "fontregular", GETSTYLE() == 0
FONTSTYLE 4
CALL CHECK, "fontstyle", GETSTYLE() == 4
FONTREGULAR
ALIGNMENT CENTER
CALL CHECKS, "currentalign", CURRENTALIGN(), "CENTER"
ALIGNMENT LEFT
REDRAW 0
CALL CHECK, "currentredraw", CURRENTREDRAW() == 0
REDRAW 1
CALL CHECK, "printc settings", PRINTCPERLINE() > 0 && PRINTCLENGTH() > 0
PRINTL a line
LOCAL = LINECOUNT
PRINTL another
CLEARLINE 1
CALL CHECK, "clearline", LINECOUNT == LOCAL
CALL CHECK, "lineisempty", LINEISEMPTY()
