;=== HTML_* functions ===
@TEST_MAIN
CALL CHECKS, "html_toplaintext", HTML_TOPLAINTEXT("<b>bold</b> &amp; <font color='#FF0000'>red</font>"), "bold & red"
CALL CHECKS, "html_escape", HTML_ESCAPE("<a & b>"), "&lt;a &amp; b&gt;"
CALL CHECK, "html_stringlen", HTML_STRINGLEN("<b>abc</b>") == 3
HTML_TAGSPLIT "x<b>y</b>z"
CALL CHECK, "html_tagsplit count", RESULT == 5
CALL CHECKS, "html_tagsplit parts", RESULTS:0 + "|" + RESULTS:1 + "|" + RESULTS:2, "x|<b>|y"
PRINT pending text
LOCALS '= HTML_POPPRINTINGSTR()
CALL CHECKS, "html_popprintingstr", HTML_TOPLAINTEXT(LOCALS), "pending text"
HTML_PRINT "<b>printed</b>"
CALL CHECKS, "html_getprintedstr", HTML_TOPLAINTEXT(HTML_GETPRINTEDSTR(0)), "printed"
; a <br> ends a line, but the end adds one only after content
; (Html2DisplayLine): AnonTW's animations print a picture, nine
; HTML_PRINT "<br>", then CLEARLINE 10
LOCAL = LINECOUNT
HTML_PRINT "<br>"
CALL CHECK, "html_print br is one line", LINECOUNT - LOCAL == 1
LOCAL = LINECOUNT
HTML_PRINT "a<br>"
CALL CHECK, "html_print trailing br", LINECOUNT - LOCAL == 1
LOCAL = LINECOUNT
HTML_PRINT "a<br>b"
CALL CHECK, "html_print br between", LINECOUNT - LOCAL == 2
; a non-zero 2nd argument leaves the line open (eraMegatenP's map rows)
LOCAL = LINECOUNT
HTML_PRINT "<b>open</b>", 1
PRINTL  and closed
LOCALS '= HTML_TOPLAINTEXT(HTML_GETPRINTEDSTR(0))
CALL CHECK, "html_print left open", LINECOUNT - LOCAL == 1
CALL CHECKS, "html_print open line text", LOCALS, "open and closed"
LOCAL = LINECOUNT
HTML_PRINT "<b>closed</b>", 0
CALL CHECK, "html_print second argument 0 ends the line", LINECOUNT - LOCAL == 1
LOCAL = LINECOUNT
HTML_PRINT "<br><br>"
CALL CHECK, "html_print two br", LINECOUNT - LOCAL == 2
LOCAL = LINECOUNT
HTML_PRINT ""
CALL CHECK, "html_print empty prints nothing", LINECOUNT - LOCAL == 0
