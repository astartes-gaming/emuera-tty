;=== control flow ===
@TEST_MAIN
;--- SELECTCASE: strings, ranges, IS, lists, CASEELSE
CALL CHECKS, "selectcase string", SEL("お酒"), "drink"
CALL CHECKS, "selectcase range", SEL2(15), "teen"
CALL CHECKS, "selectcase is", SEL2(100), "big"
CALL CHECKS, "selectcase list", SEL2(3), "small"
CALL CHECKS, "selectcase else", SEL2(-5), "other"
;--- loops
LOCAL = 0
FOR LOCAL:1, 0, 10
	SIF LOCAL:1 == 3
		CONTINUE
	SIF LOCAL:1 == 6
		BREAK
	LOCAL += LOCAL:1
NEXT
; BREAK steps the counter before leaving (Emuera behavior)
CALL CHECK, "for continue break", LOCAL == 0 + 1 + 2 + 4 + 5 && LOCAL:1 == 7
LOCAL = 0
FOR LOCAL:1, 10, 0, -2
	LOCAL += 1
NEXT
CALL CHECK, "for step down", LOCAL == 5
LOCAL = 0
WHILE LOCAL < 5
	LOCAL += 2
WEND
CALL CHECK, "while", LOCAL == 6
LOCAL = 0
DO
	LOCAL += 1
LOOP LOCAL < 3
CALL CHECK, "do loop", LOCAL == 3
LOCAL = 0
REPEAT 4
	LOCAL += COUNT
REND
CALL CHECK, "repeat count", LOCAL == 0 + 1 + 2 + 3
;--- SIF guards only the next line
LOCAL = 0
SIF 0
	LOCAL = 1
LOCAL += 10
CALL CHECK, "sif", LOCAL == 10
;--- GOTO labels
LOCAL = 0
$AGAIN
LOCAL += 1
SIF LOCAL < 3
	GOTO AGAIN
CALL CHECK, "goto", LOCAL == 3
;--- && and || short-circuit
LOCAL = 0
SIF 0 && SIDE_EFFECT()
	LOCAL = 9
CALL CHECK, "and short-circuits", FLAG:0 == 0
SIF 1 || SIDE_EFFECT()
	LOCAL = 9
CALL CHECK, "or short-circuits", FLAG:0 == 0
;--- ternary and string comparison
CALL CHECK, "ternary", (3 > 2 ? 10 # 20) == 10
CALL CHECK, "string compare", "abc" < "abd" && "a" == "a" && "a" != "b"

@SEL(ARGS)
#FUNCTIONS
SELECTCASE ARGS
	CASE "食べ物"
		RETURNF "food"
	CASE "お酒", "ワイン"
		RETURNF "drink"
ENDSELECT
RETURNF "none"

@SEL2(X)
#FUNCTIONS
#DIM X
SELECTCASE X
	CASE 1, 2, 3
		RETURNF "small"
	CASE 13 TO 19
		RETURNF "teen"
	CASE IS >= 100
		RETURNF "big"
	CASEELSE
		RETURNF "other"
ENDSELECT

@SIDE_EFFECT
#FUNCTION
FLAG:0 = 1
RETURNF 1
