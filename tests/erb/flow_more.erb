;=== CALLF, JUMP, TRY* forms, lists ===
@TEST_MAIN
RESULT = 3
CALLF SET_FLAG_F, 7
CALL CHECK, "callf ignores the value, keeps RESULT", FLAG:1 == 7 && RESULT == 3
CALLFORMF SET_FLAG_{"F"}, 8
CALL CHECK, "callformf", FLAG:1 == 8
TRYCALLF NO_SUCH_F
TRYCALLFORMF NO_SUCH_{"F"}
CALL CHECK, "trycallf of nothing goes on", 1
TRYCALLLIST
	FUNC NO_SUCH_ONE
	FUNC SET_FLAG2
	FUNC SET_FLAG3
ENDFUNC
CALL CHECK, "trycalllist calls the first that exists", FLAG:2 == 1 && FLAG:3 == 0
;--- GOTO forms
LOCAL = 0
GOTOFORM LAB{1}
LOCAL = 99
$LAB1
CALL CHECK, "gotoform", LOCAL == 0
TRYGOTO NO_SUCH_LABEL
TRYGOTOFORM NO_SUCH_{1}
LOCAL = 0
TRYCGOTO NO_SUCH_LABEL
	LOCAL = 1
CATCH
	LOCAL = 2
ENDCATCH
; TRYCGOTO to missing constant label: first branch runs, CATCH skipped (Emuera quirk)
CALL CHECK, "trycgoto catch", LOCAL == 1
TRYCGOTOFORM LAB{2}
	LOCAL = 3
CATCH
	LOCAL = 4
ENDCATCH
$LAB2
; TRYCGOTOFORM to existing label jumps to label (after ENDCATCH), neither branch runs
; LOCAL remains 1 from previous TRYCGOTO's first branch
CALL CHECK, "trycgotoform found", LOCAL == 1
; (every list names its targets with FUNC, labels here)
TRYGOTOLIST
	FUNC NO_SUCH_LABEL
	FUNC LAB3
ENDFUNC
LOCAL = 50
$LAB3
CALL CHECK, "trygotolist", LOCAL != 50
;--- JUMP: CALL that doesn't come back here
CALL JUMPER
CALL CHECK, "jump returns from the caller", FLAG:4 == 1 && FLAG:5 == 0
CALL TRY_JUMPS
CALL CHECK, "tryjump forms", FLAG:6 == 3
;--- NOSKIP blocks run whatever the skip state
LOCAL = 0
NOSKIP
	LOCAL = 1
ENDNOSKIP
CALL CHECK, "noskip", LOCAL == 1
;--- names that exist
CALL CHECK, "enumfunc", ENUMFUNCBEGINSWITH("SET_FLAG") == 3 && ENUMFUNCENDSWITH("_F") == 1 && ENUMFUNCWITH("T_FLAG") == 3
CALL CHECK, "enumvar", ENUMVARBEGINSWITH("SUITE_CHE") == 1 && ENUMVARENDSWITH("TE_CHECKS") == 1 && ENUMVARWITH("UITE_CHEC") == 1
CALL CHECK, "enummacro", ENUMMACROBEGINSWITH("SUITE_MACRO") == 2 && ENUMMACROENDSWITH("_TWO") == 1 && ENUMMACROWITH("_MACRO_") == 2
CALL CHECK, "macro value", SUITE_MACRO_ONE + SUITE_MACRO_TWO == 3
; a macro that names a variable takes its indices (eratohoReverse's
; `#DEFINE KFLAG JUEL`, then `KFLAG:1 = 2`)
SUITEFLAG:5 = 9
CALL CHECK, "macro naming a variable takes indices", FLAG:5 == 9 && SUITEFLAG:5 + 1 == 10

@SET_FLAG_F(X)
#FUNCTION
#DIM X
FLAG:1 = X
RETURNF 100

@SET_FLAG2
FLAG:2 = 1

@SET_FLAG3
FLAG:3 = 1

@JUMPER
JUMP JUMP_TARGET
FLAG:5 = 1

@JUMP_TARGET
FLAG:4 = 1

@TRY_JUMPS
TRYJUMP NO_SUCH_TARGET
TRYJUMPFORM NO_SUCH_{1}
TRYCJUMP NO_SUCH_TARGET
	FLAG:6 = 9
CATCH
	FLAG:6 = 1
ENDCATCH
TRYCJUMPFORM JUMP_{"TARGET2"}
	FLAG:6 += 0
CATCH
	FLAG:6 = 9
ENDCATCH

@JUMP_TARGET2
FLAG:6 += 1
TRYJUMPLIST
	FUNC NO_SUCH_TARGET
	FUNC JUMP_TARGET3
ENDFUNC

@JUMP_TARGET3
FLAG:6 += 1
