;=== time and random numbers ===
@TEST_MAIN
LOCAL = GETMILLISECOND()
LOCAL:1 = GETSECOND()
CALL CHECK, "clock is running", LOCAL > 0 && LOCAL:1 > 1700000000
GETTIME
CALL CHECK, "gettime statement", RESULT > 20240000000000000 && STRLENS(RESULTS) == 19
CALL CHECK, "gettimes format", STRCOUNT(GETTIMES(), "^\\d{4}/\\d{2}/\\d{2} \\d{2}:\\d{2}:\\d{2}$") == 1
;--- saves current random number state, must be called before INITRAND
;--- (was previously a no-op, but is now properly implemented alongside SFMT)
DUMPRAND
;--- INITRAND gives the same numbers
;--- it accepts no args, so the given 12345 ones should do nothing
INITRAND 12345
LOCAL:2 = RAND:1000
LOCAL:3 = RAND:1000
INITRAND 12345
CALL CHECK, "initrand repeats", RAND:1000 == LOCAL:2 && RAND:1000 == LOCAL:3
RANDOMIZE 7
LOCAL:4 = RAND:1000000
RANDOMIZE 7
CALL CHECK, "randomize repeats", RAND:1000000 == LOCAL:4
;--- Emuera's MTRandom is SFMT-19937: SFMT's own test vector for
;--- init_gen_rand(1234) starts 3440181298 1564997079 1510669302 2930277156;
;--- RAND is ((first << 32) + second) % max (SFMT.cs NextInt64)
RANDOMIZE 1234
CALL CHECKS, "sfmt vector, both words", RAND:9223372036854775807, 5552094131931051480
CALL CHECKS, "sfmt vector, low word", RAND:4294967296, 2930277156
;--- an omitted RANDOMIZE argument is 0 (INT_EXPRESSION_NULLABLE), not the clock
RANDOMIZE
LOCAL:5 = RAND:1000000
RANDOMIZE 0
CALL CHECKS, "randomize without argument is 0", RAND:1000000, LOCAL:5
