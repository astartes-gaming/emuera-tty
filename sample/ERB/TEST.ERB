@LOCALSIZE_TEST
#LOCALSIZE 3
#LOCALSSIZE 7
RESULT:0 = VARSIZE("LOCAL")
RESULT:1 = VARSIZE("LOCALS")
LOCAL:2 += 1
RESULT:2 = LOCAL:2
LOCALS:6 += "!"
RETURN RESULT:0, RESULT:1, RESULT:2

@FIND_RANGES
#DIM A, 10
#DIMS B, 10
A:3 = 7
A:6 = 7
B:2 = x
RESULT:0 = FINDELEMENT(A, 7)
RESULT:1 = FINDELEMENT(A, 0, 3)
RESULT:2 = FINDLASTELEMENT(A, 0)
RESULT:3 = FINDLASTELEMENT(B, "x")
RESULT:4 = FINDELEMENT(B, "", 2, 5, 1)
RESULT:5 = FINDLASTELEMENT(A, 7, 0, 3)
RESULT:6 = FINDLASTELEMENT(A, 7, 4, 10)
RETURN RESULT:0, RESULT:1, RESULT:2, RESULT:3, RESULT:4, RESULT:5, RESULT:6

@ARRAY_MOVES
#DIM A, 6
FOR LOCAL, 0, 6
	A:LOCAL = LOCAL + 1
NEXT
ARRAYREMOVE A, 1, 2
ARRAYSHIFT A, 1, 9, 2, 3
ARRAYREMOVE A, 4, -1
RETURN A:0 * 100000 + A:1 * 10000 + A:2 * 1000 + A:3 * 100 + A:4 * 10 + A:5

@FALLS_OFF_END
LOCAL = 1

; (a #FUNCTION can't CALL: CALLF reaches one that ends without RETURNF,
; as AnonTW's GET_OBJ → FreeAct* → MAKE_STR chain does)
@CALLS_FALLER
#FUNCTION
CALLF FUNC_FALLS_OFF_END
RETURNF 1

@FUNC_FALLS_OFF_END
#FUNCTION
LOCAL = 1
