;=== language self test: prints OK/NG lines ===
@SELFTEST
#DIMS LOCALSTR, 3
LOCAL:1 = 0
CHECKCOUNT = 0
;--- arithmetic & precedence
CALL CHECK, "arith", 1 + 2 * 3 == 7 && (1 + 2) * 3 == 9 && 7 / 2 == 3 && 7 % 3 == 1 && -3 + 5 == 2
CALL CHECK, "bits", (5 & 3) == 1 && (5 | 3) == 7 && (5 ^ 3) == 6 && (1 << 4) == 16 && GETBIT(5, 2) == 1
CALL CHECK, "ternary", (3 > 2 ? 10 # 20) == 10
SKIPDISP 1
LOCAL = ISSKIP()
SKIPDISP 0
CALL CHECK, "isskip", LOCAL == 1 && ISSKIP() == 0
CALL CHECKS, "escape like Regex.Escape", ESCAPE("a b]{x}"), "a\\ b]\\{x}"
SETANIMETIMER 0
CALL CHECK, "setanimetimer result", RESULT == 1 && MOUSEB() == ""
RESULT = 5
CALL FALLS_OFF_END
CALL CHECK, "fall-off end is RETURN 0", RESULT == 0
RESULT = 5
LOCAL = CALLS_FALLER()
CALL CHECK, "fall-off end inside #FUNCTION keeps RESULT", RESULT == 5
CALL CHECK, "strcount", STRCOUNT("36:120:", "(^|:)(36|x)($|:)") == 1 && STRCOUNT("abcabc", "bc") == 2 && STRCOUNT("a.b", "\\.") == 1
;--- strings
LOCALS = abc
LOCALS += "def"
CALL CHECKS, "strasg", LOCALS, "abcdef"
LOCALS = 　x  
CALL CHECKS, "strasgfullspace", LOCALS, "　x"
CALL CHECKS, "tostrhex", TOSTR(0x007878, "X6") + TOSTR(42, "D3"), "007878042"
LOCALS '= "x" + "y" * 3
CALL CHECKS, "strexpr", LOCALS, "xyyy"
CALL CHECK, "strlens", STRLENS("あいu") == 5 && STRLENSU("あいu") == 3
CALL CHECKS, "substring", SUBSTRING("あいうえお", 2, 4), "いう"
CALL CHECKS, "tostr", TOSTR(42, "0000"), "0042"
CALL CHECKS, "replace", REPLACE("a-b-c", "-", "+"), "a+b+c"
CALL CHECK, "strfind", STRFIND("hello world", "wor") == 6
;--- FORM
A = 7
LOCALS = 値は{A}で%"文字"%です
CALL CHECKS, "form", LOCALS, "値は7で文字です"
LOCALS = [{A,4}][%"x",3,LEFT%]
CALL CHECKS, "formpad", LOCALS, "[   7][x  ]"
LOCALS = \@ A > 5 ? 大 # 小 \@
CALL CHECKS, "formcond", LOCALS, "大"
LOCALS '= @"A={A}"
CALL CHECKS, "atform", LOCALS, "A=7"
;--- loops
LOCAL = 0
FOR LOCAL:2, 0, 10
	SIF LOCAL:2 == 5
		CONTINUE
	SIF LOCAL:2 == 8
		BREAK
	LOCAL += LOCAL:2
NEXT
CALL CHECK, "for", LOCAL == 0+1+2+3+4+6+7
LOCAL = 0
WHILE LOCAL < 5
	LOCAL ++
WEND
CALL CHECK, "while", LOCAL == 5
LOCAL = 0
DO
	LOCAL += 2
LOOP LOCAL < 9
CALL CHECK, "doloop", LOCAL == 10
LOCAL = 0
REPEAT 4
	LOCAL += COUNT
REND
CALL CHECK, "repeat", LOCAL == 6
FOR LOCAL, 10, 0, -3
NEXT
CALL CHECK, "fordown", LOCAL == -2
;--- select
LOCAL = 0
FOR LOCAL:3, 0, 6
	SELECTCASE LOCAL:3
		CASE 0
			LOCAL += 1
		CASE 1, 2
			LOCAL += 10
		CASE 3 TO 4
			LOCAL += 100
		CASE IS >= 5
			LOCAL += 1000
	ENDSELECT
NEXT
CALL CHECK, "select", LOCAL == 1 + 20 + 200 + 1000
;--- if / elseif
LOCAL = 3
IF LOCAL == 1
	LOCAL = 10
ELSEIF LOCAL == 3
	LOCAL = 30
ELSE
	LOCAL = 99
ENDIF
CALL CHECK, "ifelse", LOCAL == 30
;--- goto
LOCAL = 0
$LOOPTOP
LOCAL ++
SIF LOCAL < 3
	GOTO LOOPTOP
CALL CHECK, "goto", LOCAL == 3
;--- functions
CALL CHECK, "userfunc", SQUARE(9) == 81 && FACT(5) == 120
CALL CHECKS, "funcs", GREET("霊夢"), "こんにちは、霊夢"
CALL ADDTWO, 3, 4
CALL CHECK, "callret", RESULT == 7
TRYCALL NOSUCHFUNC
CALL CHECK, "trycall", 1
LOCAL = 0
TRYCCALL NOSUCHFUNC2
	LOCAL = 1
CATCH
	LOCAL = 2
ENDCATCH
CALL CHECK, "trycatch", LOCAL == 2
CALLFORM ADD{"TWO"}, 10, 5
CALL CHECK, "callform", RESULT == 15
;--- csv names & chara vars
CALL CHECK, "csvname", ABL:1:技巧 == 3 && ABL:2:技巧 == 5 && TALENT:1:処女 == 1
; a string value as the index is a name looked up when it runs (eraAkumaMaid's EXP_GAIN)
LOCALS = 技巧
CALL CHECK, "csvname_by_string", ABL:1:LOCALS == 3 && ABL_OF(ABLNAME:1, 2) == 5
CALL CHECKS, "charname", NAME:1, "博麗霊夢"
CALL CHECKS, "callname", CALLNAME:2, "魔理沙"
CALL CHECK, "sjiscsv", CFLAG:1:好感度 == 10 && BASE:1:体力 == 2000 && MAXBASE:1:体力 == 2000
CALL CHECK, "charanum", CHARANUM == 3 && GETCHARA(2) == 2 && FINDCHARA(NAME, "霧雨魔理沙") == 2
BASE:1:気力 = 77
LOCALS:7 '= "気力"
CALL CHECK, "index by string expression", BASE:1:(LOCALS:7) == 77 && BASE:1:("体" + "力") == BASE:1:0
CALL CHECKS, "ablname", ABLNAME:1, "技巧"
; Emuera-Anchor translation: TR_NAME, TRCHARA (CALL arguments, as in "ablname", see the originals)
CALL CHECKS, "tr_name", TR_NAME(ABL, 1) + "/" + TR_NAME("ABL", "技巧") + "/" + TR_NAME(ABL, 2), "Technique/Technique/従順"
CALL CHECKS, "trchara", CSVNICKNAME(2), "Ordinary Magician"
PRINTFORML printed: %ABLNAME:1%
CALL CHECK, "define", MAXCHARA == 10
CALL CHECK, "constarr", 定数表:2 == 4 && SUMARRAY(定数表) == 14
親密度:2 = 77
CALL CHECK, "charadata", 親密度:2 == 77
;--- arrays
VARSET LOCALSTR, "z"
CALL CHECKS, "varset", LOCALSTR:2, "z"
LOCAL:10 = 5, 3, 9, 1
CALL CHECK, "multiasg", LOCAL:12 == 9 && MAXARRAY(LOCAL, 10, 14) == 9 && MINARRAY(LOCAL, 10, 14) == 1
SPLIT "a,b,c", ",", LOCALS:5
CALL CHECK, "splitcnt", RESULT == 3
CALL CHECKS, "split", LOCALS:6, "b"
CALL CHECK, "minmax", MAX(1, 9, 4) == 9 && MIN(3, -2) == -2 && LIMIT(50, 0, 10) == 10
CALL CHECK, "inrange", INRANGE(5, 1, 5) && !INRANGE(6, 1, 5)
;--- printdata
PRINTDATAL
	DATA (printdata ok)
ENDDATA
;--- increments in expressions
LOCAL = 5
LOCAL:1 = LOCAL++ + ++LOCAL
CALL CHECK, "incdec", LOCAL == 7 && LOCAL:1 == 12
;--- nested strings / lexer corners (seen in AnonTW)
CALL CHECKS, "nestform", @"[%GREET(@"<%GREET("x")%>")%]", "[こんにちは、<こんにちは、x>]"
CALL CHECKS, "ternexpr", @"%\@ 1 ? y # n \@%", "y"
LOCALS = a%\@ 0 ? y # n \@%b
CALL CHECKS, "ternform", LOCALS, "anb"
CALL CHECKS, "sqstr", 'abc, "abc"
LOCAL = 5
CALL CHECK, "idxspace", LOCAL :0 == 5
LOCALS = x
LOCALS += "y" + "z"
CALL CHECKS, "straddexpr", LOCALS, "xyz"
LOCAL = 0
SELECTCASE 12
	CASE IS & 16
		LOCAL = 1
	CASE IS & 8
		LOCAL = 2
ENDSELECT
CALL CHECK, "caseisand", LOCAL == 2
SELECTCASE 6
	CASE 1, 6,
		LOCAL = 3
ENDSELECT
CALL CHECK, "casetrail", LOCAL == 3
;--- Emuera-EM MAP_*
CALL CHECK, "mapmissing", MAP_EXIST("M") == 0 && MAP_SIZE("M") == -1 && MAP_SET("M", "a", "1") == -1 && MAP_GET("M", "a") == ""
CALL CHECK, "mapcreate", MAP_CREATE("M") == 1 && MAP_CREATE("M") == 0 && MAP_EXIST("M") == 1
MAP_SET "M", "b", "2"
MAP_SET "M", "a", "1"
MAP_SET "M", "b", "3"
CALL CHECK, "mapset", MAP_SIZE("M") == 2 && MAP_HAS("M", "a") && !MAP_HAS("M", "z")
CALL CHECKS, "mapget", MAP_GET("M", "b") + MAP_GET("M", "zz"), "3"
CALL CHECKS, "mapkeys", MAP_GETKEYS("M"), "b,a"
CALL CHECKS, "maptoxml", MAP_TOXML("M"), "<map><p><k>b</k><v>3</v></p><p><k>a</k><v>1</v></p></map>"
MAP_GETKEYS "M", LOCALSTR, 1
CALL CHECK, "mapkeysarr", RESULT == 2 && LOCALSTR:0 == "b" && LOCALSTR:1 == "a"
MAP_REMOVE "M", "b"
CALL CHECKS, "mapremove", MAP_GETKEYS("M"), "a"
MAP_CLEAR "M"
CALL CHECK, "mapclear", MAP_SIZE("M") == 0
MAP_RELEASE "M"
CALL CHECK, "maprelease", MAP_EXIST("M") == 0
;--- VariableSize.csv applies to character variables
CALL CHECK, "varsizechara", VARSIZE("TALENT") == 1200
;--- REF parameters, function-owned LOCAL / static #DIM
LOCALSTR:1 = b
CALL REFFILL, LOCALSTR, SQUARE(2)
CALL CHECK, "refparam", LOCALSTR:0 == "x4" && LOCALSTR:1 == "by"
CALL REFDYN
CALL CHECKS, "refdynamic", RESULTS, "x0"
LOCAL = COUNTUP() + COUNTUP()
CALL CHECK, "localpersist", LOCAL == 3
LOCAL = STATICUP() + STATICUP()
CALL CHECK, "staticdim", LOCAL == 3
;--- Emuera-EM DT_* data tables
CALL CHECK, "dtcreate", DT_CREATE("T") == 1 && DT_CREATE("T") == 0 && DT_COLUMN_ADD("T", "name") == 1 && DT_COLUMN_ADD("T", "cost", "int16") == 1
DT_ROW_ADD "T", "name", "b", "cost", 1,
LOCAL:1 = DT_ROW_ADD("T", "name", "a", "cost", 3)
DT_ROW_ADD "T", "name", "c", "cost", 2
CALL CHECK, "dtrows", DT_ROW_LENGTH("T") == 3 && DT_COLUMN_EXIST("T", "cost") == 2 && DT_ROW_ADD("nope", "x", 1) == -1
CALL CHECK, "dtselect", DT_SELECT("T", "name = 'a'") == 1 && RESULT:1 == LOCAL:1
LOCAL = DT_SELECT("T", "cost >= 2", "cost DESC", LOCALSTR)
CALL CHECKS, "dtsort", DT_CELL_GETS("T", LOCALSTR:0, "name", 1) + DT_CELL_GETS("T", LOCALSTR:1, "name", 1), "ac"
CALL CHECK, "dtcell", DT_CELL_SET("T", 0, "cost", 9) == 1 && DT_CELL_GET("T", 0, "cost") == 9 && DT_CELL_SET("T", 0, "cost", "x") == -2 && DT_CELL_ISNULL("T", 5, "cost") == -2
LOCALS '= DT_TOXML("T", LOCALSTR:2)
DT_RELEASE "T"
CALL CHECK, "dtxml", DT_FROMXML("T", LOCALSTR:2, LOCALS) == 1 && DT_ROW_LENGTH("T") == 3 && DT_CELL_GET("T", LOCAL:1, "cost", 1) == 3
;XML_* on a string variable (edited text goes back into it)
LOCALS '= "<r />"
XML_ADDNODE LOCALS, "/r", "<e k='a'>x</e>"
XML_ADDNODE LOCALS, "/r", "<e k='b'>y</e>"
CALL CHECKS, "xmladd", LOCALS, "<r><e k=\"a\">x</e><e k=\"b\">y</e></r>"
LOCALSTR = 
CALL CHECK, "xmlget", XML_GET(LOCALS, "/r/e[@k='b']/text()", LOCALSTR) == 1 && LOCALSTR == "y" && XML_GET(LOCALS, "/r/*") == 2
XML_REMOVENODE LOCALS, "/r/*[1]"
CALL CHECK, "xmlremove", XML_GET(LOCALS, "/r/e[last()]/@k", 1) == 1 && RESULTS == "b" && XML_GET(LOCALS, "/r/*") == 1
CALL CHECK, "xmldoc", XML_DOCUMENT(7, "<d><v>1</v></d>") == 1 && XML_SET(7, "/d/v", "2", 0, 1) == 1 && XML_TOSTR(7) == "<d><v>2</v></d>" && XML_RELEASE(7) == 1 && XML_GET(7, "/d") == -1
LOCAL:1 = 0
LOCAL:4 = 0
LOCAL:5 = 3
VARSETEX "LOCAL", 9, 1, 2, 4
CALL CHECK, "varsetex", LOCAL:1 == 0 && LOCAL:2 == 9 && LOCAL:3 == 9 && LOCAL:4 == 0 && LOCAL:5 == 3
;saves in Emuera's format: globals, and a character exported and imported
GLOBAL:5 = 77
GLOBALS:2 '= "g"
SAVEGLOBAL
GLOBAL:5 = 0
GLOBALS:2 =
LOADGLOBAL
CALL CHECK, "saveglobal", RESULT == 1 && GLOBAL:5 == 77 && GLOBALS:2 == "g"
CFLAG:1:3 = 4242
SAVECHARA "selftest", "one chara", 1
CALL CHECK, "chkcharadata", CHKCHARADATA("selftest") == 0 && RESULTS == "one chara" && CHKCHARADATA("nope") == 1
CALL CHECK, "findcharadata", FIND_CHARADATA("self*") == 1 && RESULTS:0 == "selftest"
LOCAL = CHARANUM
LOADCHARA "selftest"
CALL CHECK, "loadchara", RESULT == 1 && CHARANUM == LOCAL + 1 && CFLAG:LOCAL:3 == 4242 && NAME:LOCAL == NAME:1
DELCHARA LOCAL
CFLAG:1:3 = 0
CALL CHECK, "getconfig", GETCONFIG("LINE HEIGHT") == GETCONFIG("一行の高さ") && GETCONFIG("Font Size") > 0 && GETCONFIG("fontsize") == GETCONFIG("フォントサイズ")
CALL GTEST
CALL MSORTTEST
CALL NEWFNTEST
; a CALLFORM name with a `%` (modulo) inside `{}`, then arguments
LOCAL = 13
RESULT = 0
TRYCCALLFORM ADDTWO{LOCAL % 10 - 3}(40, 2)
CATCH
	RESULT = -1
ENDCATCH
CALL CHECK, "callform_mod", RESULT == 42
; a `;` in a string assignment is text (Emuera reads FORM to the line end)
LOCALS = a;b ;c
CALL CHECKS, "strset_semicolon", LOCALS, "a;b ;c"
; `X ++` with a space is still a postfix increment
LOCAL = 5
CALL CHECK, "postfix_space", (LOCAL ++) == 5 && LOCAL == 6
CALL RFORMTEST
CALL CHECKS, "returnform_comma", RESULTS + "|" + RESULTS:1, "  ab|x2"
PRINTFORML selftest: {CHECKCOUNT} checks done
RETURN 0

@CHECK, ARGS, ARG
CHECKCOUNT += 1
SIF ARG
	PRINTFORML OK  %ARGS%
SIF !ARG
	PRINTFORML NG  %ARGS%  <------
RETURN 0

@CHECKS, ARGS, ARGS:1, ARGS:2
CHECKCOUNT += 1
IF ARGS:1 == ARGS:2
	PRINTFORML OK  %ARGS%
ELSE
	PRINTFORML NG  %ARGS%  got [%ARGS:1%] want [%ARGS:2%] <------
ENDIF

@ABL_OF(ARGS, ARG)
#FUNCTION
RETURNF ABL:ARG:ARGS

@SQUARE(X)
#FUNCTION
#DIM X
RETURNF X * X

@FACT(N)
#FUNCTION
#DIM N
SIF N <= 1
	RETURNF 1
RETURNF N * FACT(N - 1)

@GREET(WHO)
#FUNCTIONS
#DIMS WHO
RETURNF GREETING + "、" + WHO

@ADDTWO, ARG, ARG:1
RETURN ARG + ARG:1

@ADDTWO0, ARG, ARG:1
RETURN ARG + ARG:1

@RFORMTEST
RETURNFORM %"ab",4,RIGHT%, x{1+1}

@REFFILL, R, N
#DIMS REF R, 0
#DIM DYNAMIC N
R:0 = x{N}
R:1 += "y"

@REFDYN
#DIMS DYNAMIC D, 2
CALL REFFILL, D, 0
RESULTS = %D:0%

@COUNTUP
#FUNCTION
LOCAL += 1
RETURNF LOCAL

@STATICUP
#FUNCTION
#DIM K
K += 1
RETURNF K

;graphics buffers: draw, sprites from buffers, colour matrices
