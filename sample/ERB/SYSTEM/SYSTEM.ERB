;=== system events ===
@EVENTFIRST
PRINTL ゲーム開始
ADDCHARA 1
ADDCHARA 2
TARGET = 1
MONEY = 500
ITEMSALES:0 = 1
ITEMSALES:1 = 1
プレイヤー名 = 名無し
CALL SELFTEST
BEGIN SHOP

@SHOW_SHOP
DRAWLINE
PRINTFORML {DAY}日目  所持金:{MONEY}%MONEYLABEL%  (%NAME:MASTER%)
PRINTFORML ターゲット：%CALLNAME:TARGET% 体力{BASE:TARGET:体力} 技巧{ABL:技巧} 好感度{CFLAG:好感度}
PRINTL [100] 調教する  [101] 日を進める  [102] セーブ  [103] ロード  [999] 終了
PRINT_IMG ICON
PRINTL  ←画像
HTML_PRINT "<p align='center'><font color='#FF8080'>HTML</font> <b>太字</b> <button value='101'>[次の日]</button> <img src='BAR0' height='200'><shape type='space' param='100'><img src='BAR1' height='200'></p>"
PRINT_SHOPITEM

@USERSHOP
SELECTCASE RESULT
	CASE 100
		BEGIN TRAIN
	CASE 101
		DAY += 1
		FLAG:周回数 ++
		PRINTFORMW 夜が明けた…… ({FLAG:周回数}回目)
	CASE 102
		BEGIN SAVEGAME
	CASE 103
		BEGIN LOADGAME
	CASE 999
		QUIT
	CASEELSE
		PRINTL 無効な入力
ENDSELECT

@EVENTBUY
PRINTFORML %ITEMNAME:BOUGHT%を買った（残り{MONEY}円）

@SAVEINFO
PUTFORM {DAY}日目 %CALLNAME:TARGET%

@EVENTLOAD
PRINTL ロードしました

;=== training ===
@EVENTTRAIN
PRINTFORML %CALLNAME:TARGET%の調教を開始

@SHOW_STATUS
PRINTFORML 体力:{BASE:体力} 快C:{PALAM:快C}

@SHOW_USERCOM
PRINTL [999] 終了

@COM0
PRINTFORML %CALLNAME:TARGET%と話した
UP:快C = 10
SOURCE:恭順 = 5
RETURN 1

@COM1
BASE:体力 += 100
PRINTL 休憩した
RETURN 1

@COM_ABLE1
RETURN BASE:体力 < 2000

@SOURCE_CHECK
UPCHECK

@USERCOM
SIF RESULT == 999
	BEGIN AFTERTRAIN

@EVENTEND
PRINTL 調教終了
BEGIN SHOP
